--- Build 167 / Log 1 ---
trigger:
  branches:
    include:
    - main
  paths:
    include:
    - terraform/**
    - azure-pipelines.yml
pool:
  name: 'StaticSiteAgentPool'
variables:
- name: tfStateBucket
  value: 'epicbook-tfstate-24517'
- name: tfStateKey
  value: 'epicbook.terraform.tfstate'
- name: tfStateRegion
  value: 'us-west-1'
- name: tfStateLockTable
  value: 'epicbook-tfstate-lock'
- name: awsDefaultRegion
  value: 'us-west-1'
- name: terraformVersion
  value: '1.7.5'
- name: tfDir
  value: '$(Build.SourcesDirectory)/terraform'
- group: 'Epicbook-aws-secrets'
- group: 'Epicbook-mysql-secrets'
stages:
- stage: Validate
  displayName: 'Stage 1: Validate'
  jobs:
  - job: ValidateJob
    displayName: 'Format check and validate'
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: 'Checkout repository'
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: 'Install Terraform $(terraformVersion)'
      inputs:
        script: |
          set -euo pipefail
          command -v unzip >/dev/null 2>&1 || { sudo apt-get update -y && sudo apt-get install -y unzip; }
          rm -rf terraform terraform.zip tf_install
          curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
          mkdir tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform
          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: 'Init backend, format check, validate'
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: $(awsSecretAccessKey)
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"
          terraform fmt -check -recursive -diff
          terraform validate
        workingDirectory: $(tfDir)
- stage: Plan
  displayName: 'Stage 2: Plan'
  dependsOn:
  - Validate
  jobs:
  - job: PlanJob
    displayName: 'Create and publish Terraform plan'
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: 'Checkout repository'
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: 'Install Terraform $(terraformVersion)'
      inputs:
        script: |
          set -euo pipefail
          command -v unzip >/dev/null 2>&1 || { sudo apt-get update -y && sudo apt-get install -y unzip; }
          rm -rf terraform terraform.zip tf_install
          curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
          mkdir tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform
          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: 'Init backend and create plan'
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: $(awsSecretAccessKey)
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
        TF_VAR_db_admin_username: $(mysqlAdminUsername)
[REDACTED: sensitive value removed]
      inputs:
        script: |
          set -euo pipefail

          # Dynamically generate terraform.tfvars on the fly during the run
          echo "ssh_public_key_path = \"~/.ssh/epicbook-key.pub\"" > terraform.tfvars

          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"

          echo "Creating execution plan..."
          terraform plan -input=false -lock-timeout=5m -var-file="terraform.tfvars" -out=tfplan
        workingDirectory: $(tfDir)
    - task: PublishPipelineArtifact@1
      displayName: 'Publish tfplan artifact'
      inputs:
        targetPath: '$(tfDir)/tfplan'
        artifact: 'tfplan'
        publishLocation: 'pipeline'
- stage: Apply
  displayName: 'Stage 3: Apply'
  dependsOn:
  - Plan
  jobs:
  - deployment: ApplyDeployment
    displayName: 'Apply approved plan'
    environment:
      name: 'epicbook-infra-approval'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
            displayName: 'Checkout repository'
            inputs:
              repository: self
          - task: 30f35852-3f7e-4c0c-9a88-e127b4f97211@1
            condition: false
            inputs:
              alias: none
          - task: CmdLine@2
            displayName: 'Install Terraform $(terraformVersion)'
            inputs:
              script: |
                set -euo pipefail
                command -v unzip >/dev/null 2>&1 || { sudo apt-get update -y && sudo apt-get install -y unzip; }
                rm -rf terraform terraform.zip tf_install
                curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
                mkdir tf_install
                unzip -o terraform.zip -d tf_install
                sudo mv tf_install/terraform /usr/local/bin/terraform
                rm -rf tf_install terraform.zip
                terraform version
              workingDirectory: $(Agent.TempDirectory)
          - task: DownloadPipelineArtifact@2
            displayName: 'Download tfplan artifact'
            inputs:
              buildType: 'current'
              artifactName: 'tfplan'
              targetPath: '$(Pipeline.Workspace)/tfplan'
          - task: CmdLine@2
            displayName: 'Init backend and apply plan'
            env:
              AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
              AWS_SECRET_ACCESS_KEY: $(awsSecretAccessKey)
              AWS_DEFAULT_REGION: $(awsDefaultRegion)
            inputs:
              script: |
                set -euo pipefail
                cp "$(Pipeline.Workspace)/tfplan/tfplan" ./tfplan
                terraform init -input=false \
                  -backend-config="bucket=$(tfStateBucket)" \
                  -backend-config="key=$(tfStateKey)" \
                  -backend-config="region=$(tfStateRegion)" \
                  -backend-config="dynamodb_table=$(tfStateLockTable)"
                terraform apply -input=false -lock-timeout=5m tfplan
              workingDirectory: $(tfDir)
- stage: Outputs
  displayName: 'Stage 4: Outputs'
  dependsOn:
  - Apply
  jobs:
  - job: OutputsJob
    displayName: 'Print infrastructure outputs'
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: 'Checkout repository'
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: 'Install Terraform $(terraformVersion)'
      inputs:
        script: |
          set -euo pipefail
          command -v unzip >/dev/null 2>&1 || { sudo apt-get update -y && sudo apt-get install -y unzip; }
          rm -rf terraform terraform.zip tf_install
          curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
          mkdir tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform
          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: 'Print infrastructure outputs'
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: $(awsSecretAccessKey)
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"
          APP_PUBLIC_IP="$(terraform output -raw app_public_ip)"
          MYSQL_FQDN="$(terraform output -raw mysql_fqdn)"
          echo "app_public_ip : ${APP_PUBLIC_IP}"
          echo "mysql_fqdn    : ${MYSQL_FQDN}"
        workingDirectory: $(tfDir)
- stage: Destroy
  displayName: 'Stage 5: Destroy Infrastructure'
  dependsOn:
  - Outputs
  condition: eq(variables['Build.Reason'], 'Manual')
  jobs:
  - deployment: DestroyDeployment
    displayName: 'Tear down infrastructure'
    environment:
      name: 'epicbook-destroy-approval'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
            displayName: 'Checkout repository'
            inputs:
              repository: self
          - task: CmdLine@2
            displayName: 'Install Terraform $(terraformVersion)'
            inputs:
              script: |
                set -euo pipefail
                command -v unzip >/dev/null 2>&1 || { sudo apt-get update -y && sudo apt-get install -y unzip; }
                rm -rf terraform terraform.zip tf_install
                curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
                mkdir tf_install
                unzip -o terraform.zip -d tf_install
                sudo mv tf_install/terraform /usr/local/bin/terraform
                rm -rf tf_install terraform.zip
                terraform version
              workingDirectory: $(Agent.TempDirectory)
          - task: CmdLine@2
            displayName: 'Init backend and destroy infrastructure'
            env:
              AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
              AWS_SECRET_ACCESS_KEY: $(awsSecretAccessKey)
              AWS_DEFAULT_REGION: $(awsDefaultRegion)
              TF_VAR_db_admin_username: $(mysqlAdminUsername)
[REDACTED: sensitive value removed]
            inputs:
              script: |
                set -euo pipefail

                echo "ssh_public_key_path = \"~/.ssh/epicbook-key.pub\"" > terraform.tfvars

                terraform init -input=false \
                  -backend-config="bucket=$(tfStateBucket)" \
                  -backend-config="key=$(tfStateKey)" \
                  -backend-config="region=$(tfStateRegion)" \
                  -backend-config="dynamodb_table=$(tfStateLockTable)"

                echo "Executing terraform destroy..."
                terraform destroy -input=false -auto-approve -var-file="terraform.tfvars"
              workingDirectory: $(tfDir)


